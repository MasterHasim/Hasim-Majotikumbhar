# Copy to .env.local (gitignored) — Vite only exposes variables prefixed VITE_.

# Same Firebase project as the Apps Script build (whatsapp-panel-db). Get these
# from Firebase Console -> Project Settings -> General -> "Your apps" -> the
# registered web app's config snippet.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=whatsapp-panel-db.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://whatsapp-panel-db-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=whatsapp-panel-db

# Local Workers dev server by default; set to the deployed Workers URL for production builds.
VITE_API_BASE_URL=http://localhost:8787
